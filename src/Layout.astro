---
import "@styles/styles.scss";

const { seo, lang } = Astro.props as {
  seo?: {
    title: string;
    description: string;
    keywords?: string;
  };
  lang?: string;
};
const title =
  seo?.title ?? "Aduoer Music – One player for all the music you own";
const description =
  seo?.description ??
  "Aduoer brings Wow sources, Jellyfin, Navidrome, Plex, NAS folders, cloud drives and local files into one native player for iPhone, iPad, Mac and Apple TV.";
const baseUrl = import.meta.env.BASE_URL;
const normalizedBaseUrl = `${baseUrl.replace(/\/+$/, "")}/`;
const assetUrl = (path: string) =>
  `${normalizedBaseUrl}${path.replace(/^\/+/, "")}`;
const canonicalUrl = new URL(
  Astro.url.pathname.replace(/\/+$/, "") || "/",
  Astro.site,
);
const imageUrl = new URL(assetUrl("og.png"), Astro.site);
---

<!doctype html>
<html lang={lang ?? "zh-Hans"}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    />
    <meta name="theme-color" content="#f8fafc" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href={assetUrl("app-icon.png")} />
    <link rel="apple-touch-icon" href={assetUrl("app-icon.png")} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    {seo?.keywords && <meta name="keywords" content={seo.keywords} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href={assetUrl("sitemap-index.xml")} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script is:inline>
      // Resolve the stored appearance before first paint to avoid a flash.
      (function () {
        try {
          var stored = localStorage.getItem("aduoer-theme");
          var resolved =
            stored === "light" || stored === "dark"
              ? stored
              : matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          var root = document.documentElement;
          root.dataset.theme = resolved;
          root.style.colorScheme = resolved;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta)
            meta.setAttribute(
              "content",
              resolved === "dark" ? "#0b0f17" : "#f8fafc",
            );
        } catch (error) {}
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
