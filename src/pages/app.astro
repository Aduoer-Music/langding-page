---
import Layout from "Layout.astro";
import { APP_STORE_URL } from "../lib/appStore";

const baseUrl = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
---

<Layout
  seo={{
    title: "Aduoer Music",
    description: "在 App Store 下载 Aduoer。",
  }}
>
  <main class="app-redirect">
    <img src={`${baseUrl}app-icon.png`} alt="" />
    <h1>App Store</h1>
    <p>下载 Aduoer，开始连接和聆听你的音乐。</p>
    <a
      id="app-store-link"
      href={APP_STORE_URL}
      target="_blank"
      rel="noreferrer"
    >前往 App Store</a>
  </main>
</Layout>

<script>
  import { getLocalizedAppStoreUrl } from "../lib/appStore";

  const appStoreLink = document.querySelector<HTMLAnchorElement>(
    "#app-store-link",
  );

  if (appStoreLink) appStoreLink.href = getLocalizedAppStoreUrl();
</script>
